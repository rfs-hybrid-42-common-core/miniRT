# ==============================================================================
# EVALUATION: BRIGHTNESS 2/2 (COMPLEX SCENE)
# ==============================================================================

A 0.2 255,255,255
C 0,5,-25      0,-0.1,1   60
L -10,15,-10   0.8        255,255,255

# --- TEST 2: Complex Scene Shadows ---
# "Put a complex scene together with several objects like on illustration V.6 
# page 10 of the subject. Shadows must be properly displayed without glitching."

# Floor Plane
pl 0,-5,0      0,1,0      200,200,200

# Two cylindrical pillars
cy -6,-2,0     0,1,0      4   6   255,0,0
cy 6,-2,0      0,1,0      4   6   0,0,255

# Three spheres (one central on the floor, two resting on top of the pillars)
sp 0,-2,3      6          0,255,0
sp -6,3,0      4          255,255,0
sp 6,3,0       4          0,255,255

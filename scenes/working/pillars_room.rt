# ==========================================
# miniRT - Classic Pillar & Cross-Shadows
# ==========================================

# 1. ENVIRONMENT & RENDER SETTINGS
# ==========================================
R 1024 768
A 0.1   255,255,255
C 0,5.5,-12   0,0,1   70   ap:0.5   focal:12.65

# The 2 corner Point Lights creating the "X" shadow pattern
L -14.5,8.2,-13   0.7   255,255,255
L +14.5,8.2,-13   0.7   255,255,255

# 2. THE ROOM
# ==========================================
# Grey Floor
pl 0,00,00   0,+1,+0   128,128,128

# Dark Grey Ceiling
pl 0,10,00   0,-1,+0   050,050,050

# Blue Back Wall
pl 0,00,15   0,+0,-1   050,050,255

# 3. THE CENTERPIECE
# ==========================================
# Red Sphere (Radius 0.75, resting on the floor at Y=1.5)
sp 0,1.5,0            1.5        255,000,000   mat:0.1,0.8,0.8,20   mov:0,1.5,-2

# 4. THE PILLARS (Front Left)
# ==========================================
cy -5,05,00   0,1,0   2.0 10.0   200,200,200   mat:0.1,0.8,0.8,20
sp -5,00,00           3.0        200,200,200   mat:0.1,0.8,0.8,20
sp -5,10,00           3.0        200,200,200   mat:0.1,0.8,0.8,20

# 5. THE PILLARS (Front Right)
# ==========================================
cy +5,05,00   0,1,0   2.0 10.0   200,200,200   mat:0.1,0.8,0.8,20
sp +5,00,00           3.0        200,200,200   mat:0.1,0.8,0.8,20
sp +5,10,00           3.0        200,200,200   mat:0.1,0.8,0.8,20

# 6. THE PILLARS (Back Left)
# ==========================================
cy -5,05,10   0,1,0   2.0 10.0   200,200,200   mat:0.1,0.8,0.8,20
sp -5,00,10           3.0        200,200,200   mat:0.1,0.8,0.8,20
sp -5,10,10           3.0        200,200,200   mat:0.1,0.8,0.8,20

# 7. THE PILLARS (Back Right)
# ==========================================
cy +5,05,10   0,1,0   2.0 10.0   200,200,200   mat:0.1,0.8,0.8,20
sp +5,00,10           3.0        200,200,200   mat:0.1,0.8,0.8,20
sp +5,10,10           3.0        200,200,200   mat:0.1,0.8,0.8,20

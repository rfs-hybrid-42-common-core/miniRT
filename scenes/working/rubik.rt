# ==========================================
# miniRT - Rubik's Cubes
# ==========================================

R 1920 1080
A 0.05   255,255,255

C -73.75,42.5,95.0   0.595,-0.400,-0.757   40   ap:1.0   focal:127.5

L -40.0,30.0,-30.0   1.0   255,255,255   type:area   uvec:5,0,0   ustep:4   vvec:0,0,5   vstep:4
L 120.0,10.0, 50.0   1.0   255,255,255

# ==========================================
# THE 5-POINT SPOTLIGHT ARRAY
# ==========================================

# Top Spotlight

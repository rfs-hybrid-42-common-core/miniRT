# ==============================================================================
# miniRT - The Atomium (Foundation)
# ==============================================================================

# --- Environment & Settings ---
R 1024 768
A 0.3   255,255,255

# Camera positioned back and slightly low to give it a towering presence
C +35,+15,-60   -0.65,0.1,1   60   ap:0.0   focal:40.0

# Main Sun Light
L -30,+60,-40   0.9   255,250,245   type:area   uvec:5,0,0   ustep:4   vvec:0,0,5   vstep:4

# Secondary Fill Light
L +40,+20,-20   0.3   200,220,255

# ==============================================================================
# SCENE ENVIRONMENT
# ==============================================================================

# Floor Plane (Concrete)
pl +00.000,+00.000,+00.000   +0.0000,+1.0000,+0.0000   180,180,180   mat:0.2,0.8,0.1,10

# Environment Dome
sp +00.000,+00.000,+00.000   2000.0                    200,200,255   dome:./textures/empty_room.xpm

# ==============================================================================
# THE ATOMIUM: Base Pavilion
# ==============================================================================

# The bottom observation deck/pavilion the structure rests on
cy +00.000,+00.500,+00.000   +0.0000,+1.0000,+0.0000   24.0 1.0   220,220,220   mat:0.2,0.8,0.2,50   caps:1

# ==============================================================================
# THE ATOMIUM: The 9 Core Spheres (Dark Chrome Material)
# ==============================================================================
# Dropped base color to 15,15,15. 
# Lowered diffuse, maximized specular, increased reflection to 0.8.

# Center, Top, and Bottom Vertices
sp +00.000,+20.000,+00.000   8.0   15,15,15   mat:0.1,0.2,1.0,200   ref:0.2   img:./textures/metal.xpm   bump:./textures/metal_bump.xpm,0.01,0.05
sp +00.000,+35.000,+00.000   8.0   15,15,15   mat:0.1,0.2,1.0,200   ref:0.2   img:./textures/metal.xpm   bump:./textures/metal_bump.xpm,0.01,0.05
sp +00.000,+05.000,+00.000   8.0   15,15,15   mat:0.1,0.2,1.0,200   ref:0.2   img:./textures/metal.xpm   bump:./textures/metal_bump.xpm,0.01,0.05

# The Lower Triangle (Y = 15.0)
sp +14.140,+15.000,+00.000   8.0   15,15,15   mat:0.1,0.2,1.0,200   ref:0.2   img:./textures/metal.xpm   bump:./textures/metal_bump.xpm,0.01,0.05
sp -07.070,+15.000,+12.250   8.0   15,15,15   mat:0.1,0.2,1.0,200   ref:0.2   img:./textures/metal.xpm   bump:./textures/metal_bump.xpm,0.01,0.05
sp -07.070,+15.000,-12.250   8.0   15,15,15   mat:0.1,0.2,1.0,200   ref:0.2   img:./textures/metal.xpm   bump:./textures/metal_bump.xpm,0.01,0.05

# The Upper Triangle (Y = 25.0)
sp +07.070,+25.000,+12.250   8.0   15,15,15   mat:0.1,0.2,1.0,200   ref:0.2   img:./textures/metal.xpm   bump:./textures/metal_bump.xpm,0.01,0.05
sp -14.140,+25.000,+00.000   8.0   15,15,15   mat:0.1,0.2,1.0,200   ref:0.2   img:./textures/metal.xpm   bump:./textures/metal_bump.xpm,0.01,0.05
